diff --git a/Cargo.toml b/Cargo.toml
index aec4374..8c13d5a 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -25,3 +25,6 @@ strip = true  # Automatically strip symbols from the binary.
 opt-level = 3
 lto = "thin"  # Link time optimization.
 
+
+[patch.crates-io]
+c2pa_raw_crypto = { path = "/tmp/patched/c2pa_raw_crypto" }
diff --git a/sdk/src/crypto/cose/certificate_profile.rs b/sdk/src/crypto/cose/certificate_profile.rs
index 0026265..0e32fa5 100644
--- a/sdk/src/crypto/cose/certificate_profile.rs
+++ b/sdk/src/crypto/cose/certificate_profile.rs
@@ -186,7 +186,13 @@ pub fn check_certificate_profile(
         || *cert_alg == ECDSA_WITH_SHA384_OID
         || *cert_alg == ECDSA_WITH_SHA512_OID
         || *cert_alg == RSASSA_PSS_OID
-        || *cert_alg == ED25519_OID)
+        || *cert_alg == ED25519_OID
+        // FIPS 204. This allow-list is a gate independent of SigningAlg: a
+        // certificate signed with ML-DSA is rejected here even when every
+        // other layer accepts it.
+        || *cert_alg == ML_DSA_44_OID
+        || *cert_alg == ML_DSA_65_OID
+        || *cert_alg == ML_DSA_87_OID)
     {
         log_item!(
             "",
@@ -585,6 +591,12 @@ const ECDSA_WITH_SHA256_OID: Oid<'static> = oid!(1.2.840 .10045 .4 .3 .2);
 const ECDSA_WITH_SHA384_OID: Oid<'static> = oid!(1.2.840 .10045 .4 .3 .3);
 const ECDSA_WITH_SHA512_OID: Oid<'static> = oid!(1.2.840 .10045 .4 .3 .4);
 const SHA256_WITH_RSAENCRYPTION_OID: Oid<'static> = oid!(1.2.840 .113549 .1 .1 .11);
+
+// NIST ML-DSA, FIPS 204. The same OID identifies the subject key algorithm
+// and the certificate signature algorithm.
+const ML_DSA_44_OID: Oid<'static> = oid!(2.16.840 .1 .101 .3 .4 .3 .17);
+const ML_DSA_65_OID: Oid<'static> = oid!(2.16.840 .1 .101 .3 .4 .3 .18);
+const ML_DSA_87_OID: Oid<'static> = oid!(2.16.840 .1 .101 .3 .4 .3 .19);
 const SHA384_WITH_RSAENCRYPTION_OID: Oid<'static> = oid!(1.2.840 .113549 .1 .1 .12);
 const SHA512_WITH_RSAENCRYPTION_OID: Oid<'static> = oid!(1.2.840 .113549 .1 .1 .13);
 const ED25519_OID: Oid<'static> = oid!(1.3.101 .112);
diff --git a/sdk/src/crypto/cose/sign.rs b/sdk/src/crypto/cose/sign.rs
index c9c3a48..d2f1276 100644
--- a/sdk/src/crypto/cose/sign.rs
+++ b/sdk/src/crypto/cose/sign.rs
@@ -393,6 +393,11 @@ fn build_protected_header(
         SigningAlg::Es384 => HeaderBuilder::new().algorithm(iana::Algorithm::ES384),
         SigningAlg::Es512 => HeaderBuilder::new().algorithm(iana::Algorithm::ES512),
         SigningAlg::Ed25519 => HeaderBuilder::new().algorithm(iana::Algorithm::EdDSA),
+        // RFC 9964 identifiers. `coset` already carries them; only this
+        // mapping was missing.
+        SigningAlg::MlDsa44 => HeaderBuilder::new().algorithm(iana::Algorithm::ML_DSA_44),
+        SigningAlg::MlDsa65 => HeaderBuilder::new().algorithm(iana::Algorithm::ML_DSA_65),
+        SigningAlg::MlDsa87 => HeaderBuilder::new().algorithm(iana::Algorithm::ML_DSA_87),
         _ => return Err(CoseError::UnsupportedSigningAlgorithm),
     };
 
diff --git a/sdk/src/crypto/cose/sign1.rs b/sdk/src/crypto/cose/sign1.rs
index fcd7288..34d990c 100644
--- a/sdk/src/crypto/cose/sign1.rs
+++ b/sdk/src/crypto/cose/sign1.rs
@@ -73,6 +73,9 @@ pub fn signing_alg_from_sign1(sign1: &coset::CoseSign1) -> Result<SigningAlg, Co
             -35 => Ok(SigningAlg::Es384),
             -7 => Ok(SigningAlg::Es256),
             -8 => Ok(SigningAlg::Ed25519),
+            -48 => Ok(SigningAlg::MlDsa44),
+            -49 => Ok(SigningAlg::MlDsa65),
+            -50 => Ok(SigningAlg::MlDsa87),
             _ => Err(CoseError::UnsupportedSigningAlgorithm),
         },
 
@@ -84,6 +87,9 @@ pub fn signing_alg_from_sign1(sign1: &coset::CoseSign1) -> Result<SigningAlg, Co
             Algorithm::ES384 => Ok(SigningAlg::Es384),
             Algorithm::ES256 => Ok(SigningAlg::Es256),
             Algorithm::EdDSA => Ok(SigningAlg::Ed25519),
+            Algorithm::ML_DSA_44 => Ok(SigningAlg::MlDsa44),
+            Algorithm::ML_DSA_65 => Ok(SigningAlg::MlDsa65),
+            Algorithm::ML_DSA_87 => Ok(SigningAlg::MlDsa87),
             _ => Err(CoseError::UnsupportedSigningAlgorithm),
         },
 
diff --git a/sdk/src/crypto/cose/verifier.rs b/sdk/src/crypto/cose/verifier.rs
index 714fae8..913903e 100644
--- a/sdk/src/crypto/cose/verifier.rs
+++ b/sdk/src/crypto/cose/verifier.rs
@@ -66,6 +66,11 @@ const EC_PUBLICKEY_OID: Oid<'static> = oid!(1.2.840 .10045 .2 .1);
 const RSA_OID: Oid<'static> = oid!(1.2.840 .113549 .1 .1 .1);
 const RSASSA_PSS_OID: Oid<'static> = oid!(1.2.840 .113549 .1 .1 .10);
 const ED25519_OID: Oid<'static> = oid!(1.3.101 .112);
+
+// NIST ML-DSA subject public key algorithm identifiers, FIPS 204.
+const ML_DSA_44_OID: Oid<'static> = oid!(2.16.840 .1 .101 .3 .4 .3 .17);
+const ML_DSA_65_OID: Oid<'static> = oid!(2.16.840 .1 .101 .3 .4 .3 .18);
+const ML_DSA_87_OID: Oid<'static> = oid!(2.16.840 .1 .101 .3 .4 .3 .19);
 const PRIME256V1_OID: Oid<'static> = oid!(1.2.840 .10045 .3 .1 .7);
 const SECP384R1_OID: Oid<'static> = oid!(1.3.132 .0 .34);
 const SECP521R1_OID: Oid<'static> = oid!(1.3.132 .0 .35);
@@ -92,6 +97,9 @@ fn spki_matches_signing_alg(alg: SigningAlg, spki: &AlgorithmIdentifier) -> bool
             *key_alg == RSA_OID || *key_alg == RSASSA_PSS_OID
         }
         SigningAlg::Ed25519 => *key_alg == ED25519_OID,
+        SigningAlg::MlDsa44 => *key_alg == ML_DSA_44_OID,
+        SigningAlg::MlDsa65 => *key_alg == ML_DSA_65_OID,
+        SigningAlg::MlDsa87 => *key_alg == ML_DSA_87_OID,
         _ => false,
     }
 }
